table RouteDay
	lineageTag: 9f9ab4e3-067f-53c0-8c9e-26ea72d0cb7d

	measure 'Total Revenue' = SUM(RouteDay[REVENUE])
		formatString: #,0
		lineageTag: 0f9764f1-5d6e-5fdf-abc0-daa5875577fe

	measure 'Total Passengers' = SUM(RouteDay[PASSENGERS])
		formatString: #,0
		lineageTag: a627b259-a976-56d5-bf95-632f0281d0db

	measure 'Total Trips' = SUM(RouteDay[TRIPS])
		formatString: #,0
		lineageTag: e946250b-9ac3-5758-b038-ad5f72361f38

	measure 'On-time %' = DIVIDE(SUM(RouteDay[ON_TIME_TRIPS]), SUM(RouteDay[TRIPS]))
		formatString: 0.0%
		lineageTag: 4c5b637f-1272-571d-8ca6-ad6b3a6a72c0

	measure 'Revenue per km' = DIVIDE(SUM(RouteDay[REVENUE]), SUM(RouteDay[KM]))
		formatString: #,0.00
		lineageTag: b61fec7d-bdca-598a-aea0-c79b1795aa05

	column DATE_KEY
		dataType: dateTime
		formatString: Long Date
